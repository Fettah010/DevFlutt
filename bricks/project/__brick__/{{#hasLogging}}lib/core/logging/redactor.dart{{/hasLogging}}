import 'log_record.dart';

/// Removes sensitive values from log records.
///
/// The redactor is applied by the logger before a record is created, so a sink
/// cannot leak a sensitive value by omission. A value is replaced when
///
/// - the field key is a known sensitive name;
/// - the field key contains `authorization` or `credential`;
/// - the value itself looks like a credential.
///
/// The list of keys is deliberately conservative: an unrecognised field is
/// logged, so a new sensitive shape must be added to the corpus.
class Redactor {
  const Redactor({
    this.sensitiveKeys = defaultSensitiveKeys,
    this.redactedValue = '<redacted>',
  });

  /// The replacement written in place of a sensitive value.
  final String redactedValue;

  /// The field keys whose values are always redacted.
  final Set<String> sensitiveKeys;

  /// The field key fragments that mark a value as sensitive.
  static const Set<String> sensitiveKeyFragments = <String>{
    'authorization',
    'credential',
  };

  /// The default set of sensitive field keys, matched case-insensitively.
  static const Set<String> defaultSensitiveKeys = <String>{
    'authorization',
    'proxy-authorization',
    'cookie',
    'set-cookie',
    'password',
    'passwd',
    'secret',
    'token',
    'access_token',
    'refresh_token',
    'id_token',
    'api_key',
    'apikey',
    'client_secret',
    'private_key',
    'session',
    'credit_card',
    'card_number',
    'cvv',
    'cvc',
    'pin',
  };

  /// Returns a copy of [record] with every sensitive value redacted.
  LogRecord redact(LogRecord record) => LogRecord(
    level: record.level,
    message: redactText(record.message),
    category: record.category,
    timestamp: record.timestamp,
    fields: redactFields(record.fields),
    errorMessage: record.errorMessage == null
        ? null
        : redactText(record.errorMessage!),
    stackTrace: record.stackTrace == null
        ? null
        : redactText(record.stackTrace!),
  );

  /// Returns a copy of [fields] with every sensitive value redacted.
  Map<String, Object?> redactFields(Map<String, Object?> fields) {
    if (fields.isEmpty) {
      return const <String, Object?>{};
    }
    return <String, Object?>{
      for (final entry in fields.entries)
        entry.key: _isSensitiveKey(entry.key)
            ? redactedValue
            : _redactValue(entry.value),
    };
  }

  /// Returns [text] with every embedded credential replaced.
  ///
  /// The replacement is applied to the parts of the text that look like a
  /// credential, so the surrounding explanation survives.
  String redactText(String text) {
    var result = text.replaceAll(_jwtPattern, redactedValue);
    result = result.replaceAll(_schemePattern, redactedValue);
    result = result.replaceAllMapped(_opaquePattern, (match) {
      final candidate = match[0]!;
      return _isOpaqueSecret(candidate) ? redactedValue : candidate;
    });
    return result;
  }

  Object? _redactValue(Object? value) {
    if (value is String) {
      return redactText(value);
    }
    if (value is Map<String, Object?>) {
      return redactFields(value);
    }
    if (value is Iterable<Object?>) {
      return value.map(_redactValue).toList(growable: false);
    }
    return value;
  }

  bool _isSensitiveKey(String key) {
    final normalized = key.toLowerCase();
    if (sensitiveKeys.contains(normalized)) {
      return true;
    }
    return sensitiveKeyFragments.any(normalized.contains);
  }

  static final RegExp _jwtPattern = RegExp(
    r'ey[A-Za-z0-9_-]{4,}\.[A-Za-z0-9_-]{4,}\.[A-Za-z0-9_-]*',
  );

  static final RegExp _schemePattern = RegExp(
    r'(?:(?:Bearer|Basic)\s+[A-Za-z0-9._~+/=-]{8,}'
    r'|(?:Token)\s+[A-Za-z0-9._~+/=-]{16,})',
    caseSensitive: false,
  );

  static final RegExp _opaquePattern = RegExp(r'[A-Za-z0-9_-]{32,}');

  /// Whether [candidate] is long and mixed enough to be a credential rather
  /// than an ordinary identifier.
  static bool _isOpaqueSecret(String candidate) {
    if (candidate.length < 32) {
      return false;
    }
    var hasLetter = false;
    var hasDigit = false;
    for (final unit in candidate.codeUnits) {
      final character = String.fromCharCode(unit);
      if (character.contains(RegExp('[A-Za-z]'))) {
        hasLetter = true;
      }
      if (character.contains(RegExp('[0-9]'))) {
        hasDigit = true;
      }
    }
    return hasLetter && hasDigit;
  }
}
