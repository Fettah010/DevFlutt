import '../auth_error.dart';
import '../auth_session.dart';

/// The provider boundary of the REST authentication adapter.
///
/// The adapter depends on this interface, never on the HTTP client. The real
/// implementation talks to the backend through the `ApiClient` of the
/// networking module; the fake implementation is used by the tests.
///
/// Every method throws an [AuthError] on failure. A provider exception never
/// reaches the caller.
abstract interface class RestAuthPort {
  /// Signs in with an email address and a password.
  ///
  /// Throws [InvalidCredentialsError] when the backend rejects them.
  Future<AuthSession> signIn({required String email, required String password});

  /// Creates an account with an email address and a password.
  Future<AuthSession> register({
    required String email,
    required String password,
  });

  /// Obtains a new session from a refresh token.
  ///
  /// Throws [InvalidCredentialsError] when the backend rejects the token, and
  /// [SessionExpiredError] when the session cannot be renewed.
  Future<AuthSession> refresh(String refreshToken);

  /// Ends the session on the backend, usually by revoking the refresh token.
  Future<void> logout(String refreshToken);

  /// Asks the backend to send a password-reset message to [email].
  Future<void> requestPasswordReset(String email);
}
