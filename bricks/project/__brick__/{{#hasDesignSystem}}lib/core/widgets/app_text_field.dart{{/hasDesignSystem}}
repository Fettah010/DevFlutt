import 'package:flutter/material.dart';

import '../theme/app_tokens.dart';

/// A labelled text field that follows the application theme.
class AppTextField extends StatelessWidget {
  const AppTextField({
    super.key,
    required this.label,
    this.controller,
    this.onChanged,
    this.keyboardType,
    this.validator,
    this.textInputAction,
    this.obscureText = false,
    this.enabled = true,
  });

  /// The field label.
  final String label;

  /// The controller that holds the field value.
  final TextEditingController? controller;

  /// Called whenever the value changes.
  final ValueChanged<String>? onChanged;

  /// The keyboard type shown for this field.
  final TextInputType? keyboardType;

  /// Optional form validation message. Requires a surrounding [Form] to run.
  final FormFieldValidator<String>? validator;

  /// The action shown on the software keyboard.
  final TextInputAction? textInputAction;

  /// Whether entered text is obscured, for example in a password field.
  final bool obscureText;

  /// Whether the field accepts input.
  final bool enabled;

  @override
  Widget build(BuildContext context) {
    return TextFormField(
      controller: controller,
      onChanged: onChanged,
      keyboardType: keyboardType,
      validator: validator,
      textInputAction: textInputAction,
      obscureText: obscureText,
      enabled: enabled,
      decoration: InputDecoration(
        labelText: label,
        contentPadding: const EdgeInsets.all(AppSpacing.md),
      ),
    );
  }
}
