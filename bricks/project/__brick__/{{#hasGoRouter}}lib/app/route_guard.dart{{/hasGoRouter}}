/// A redirect that sends an unauthenticated user to the login location.
///
/// The intended destination is preserved in the query string, so a protected
/// deep link returns the user to where they were going after they sign in.
///
/// The template ships no login screen — the login route belongs to the
/// application — so the application passes its own location. Wire it like
/// this in `app.dart`:
///
/// ```dart
/// late final _router = buildAppRouter(
///   redirect: authRouteGuard(
///     authAdapter: services!.authAdapter,
///     loginLocation: AppRoutes.login,
///   ),
/// );
/// ```
RouteRedirect authRouteGuard({
  required AuthAdapter authAdapter,
  required String loginLocation,
}) {
  return (state) => authRouteRedirect(
    state: authAdapter.currentState,
    requestedLocation: state.uri.toString(),
    loginLocation: loginLocation,
  );
}
