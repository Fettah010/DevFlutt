import 'product.dart';

class CartLine {
  const CartLine({required this.product, required this.quantity});
  final Product product;
  final int quantity;
  int get lineTotalMinor => product.unitPriceMinor * quantity;
}

/// Immutable cart using integer minor units to avoid floating-point totals.
class Cart {
  Cart._(this.lines);
  factory Cart.empty() => Cart._(const <CartLine>[]);
  factory Cart.fromLines(Iterable<CartLine> lines) => Cart._(List.unmodifiable(lines));

  final List<CartLine> lines;
  int get totalMinor => lines.fold<int>(0, (total, line) => total + line.lineTotalMinor);
  bool get isEmpty => lines.isEmpty;

  Cart add(Product product, {int quantity = 1}) {
    if (quantity <= 0) throw ArgumentError.value(quantity, 'quantity', 'Must be positive.');
    if (product.unitPriceMinor < 0) {
      throw ArgumentError.value(product.unitPriceMinor, 'unitPriceMinor', 'Cannot be negative.');
    }
    final updated = List<CartLine>.of(lines);
    final index = updated.indexWhere((line) => line.product.id == product.id);
    if (index == -1) {
      updated.add(CartLine(product: product, quantity: quantity));
    } else {
      final current = updated[index];
      updated[index] = CartLine(product: current.product, quantity: current.quantity + quantity);
    }
    return Cart._(List.unmodifiable(updated));
  }

  Cart remove(String productId) =>
      Cart._(List.unmodifiable(lines.where((line) => line.product.id != productId)));

  Map<String, Object> toJson() => <String, Object>{
    'lines': lines.map((line) => <String, Object>{
      'id': line.product.id,
      'name': line.product.name,
      'unitPriceMinor': line.product.unitPriceMinor,
      'quantity': line.quantity,
    }).toList(growable: false),
  };

  factory Cart.fromJson(Map<String, Object?> json) {
    final values = json['lines']! as List<Object?>;
    return Cart.fromLines(values.map((value) {
      final line = (value! as Map<Object?, Object?>).cast<String, Object?>();
      return CartLine(
        product: Product(
          id: line['id']! as String,
          name: line['name']! as String,
          unitPriceMinor: line['unitPriceMinor']! as int,
        ),
        quantity: line['quantity']! as int,
      );
    }));
  }
}
