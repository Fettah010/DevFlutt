/// A note stored locally and optionally refreshed from a remote source.
class OfflineNote {
  const OfflineNote({required this.id, required this.title, required this.updatedAtEpochMillis});

  final String id;
  final String title;
  final int updatedAtEpochMillis;

  Map<String, Object> toJson() => <String, Object>{
    'id': id,
    'title': title,
    'updatedAtEpochMillis': updatedAtEpochMillis,
  };

  factory OfflineNote.fromJson(Map<String, Object?> json) => OfflineNote(
    id: json['id']! as String,
    title: json['title']! as String,
    updatedAtEpochMillis: json['updatedAtEpochMillis']! as int,
  );
}
