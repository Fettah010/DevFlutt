void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();

  testWidgets('selected Android platform services initialize natively', (tester) async {
    debugPrint('Starting generated app bootstrap.');
    await bootstrap();
    debugPrint('Generated app bootstrap completed.');
    await tester.pump();
    expect(tester.takeException(), isNull);

{{#hasBackgroundWork}}    debugPrint('Scheduling and cancelling WorkManager smoke task.');
    const scheduler = WorkmanagerTaskScheduler();
    const taskName = 'devflutt.platform-services-smoke';
    await scheduler.scheduleOneOff(
      BackgroundTask(uniqueName: taskName, taskName: sampleBackgroundTaskName),
    );
    await scheduler.cancel(taskName);
    debugPrint('WorkManager smoke task completed.');
{{/hasBackgroundWork}}{{#hasLocalNotifications}}    debugPrint('Showing test notification.');
    final notificationShown = await LocalNotificationService().show(
      id: 740801,
      title: 'Platform service smoke test',
      body: 'Test-only notification.',
      route: '/',
    );
    expect(
      notificationShown,
      const bool.fromEnvironment('DEVFLUTT_EXPECT_NOTIFICATIONS_GRANTED'),
    );
    debugPrint('Notification permission path completed.');
{{/hasLocalNotifications}}{{#hasAppUpdates}}    debugPrint('Checking Play update availability.');
    final updateOutcome = await PlayAppUpdateClient(
      applicationId: '{{applicationId}}',
    ).checkForUpdate();
    expect(
      updateOutcome.status,
      isIn(<AppUpdateStatus>[
        AppUpdateStatus.available,
        AppUpdateStatus.unavailable,
        AppUpdateStatus.unsupported,
        AppUpdateStatus.failed,
      ]),
    );
    debugPrint('Play update availability check completed: ${updateOutcome.status}.');
{{/hasAppUpdates}}  });
}
