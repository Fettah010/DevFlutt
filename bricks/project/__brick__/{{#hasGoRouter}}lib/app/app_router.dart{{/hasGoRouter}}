{{#hasFeatureExample}}import '../features/counter/presentation/counter_page.dart';
{{/hasFeatureExample}}{{#hasShowcase}}import '../features/showcase/presentation/showcase_page.dart';
{{/hasShowcase}}{{#hasOfflineData}}import '../features/offline_notes/presentation/offline_notes_page.dart';
{{/hasOfflineData}}import '../features/home/home_page.dart';
{{#hasCommerce}}import '../features/commerce/presentation/commerce_page.dart';
