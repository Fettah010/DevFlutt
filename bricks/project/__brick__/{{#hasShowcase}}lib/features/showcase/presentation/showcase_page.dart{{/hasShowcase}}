import 'package:flutter/material.dart';

import '../../../core/widgets/app_button.dart';
import '../../../core/widgets/app_card.dart';
import '../../../core/widgets/app_bottom_sheet.dart';
import '../../../core/widgets/app_confirmation_dialog.dart';
import '../../../core/widgets/app_list_item.dart';
import '../../../core/widgets/app_message.dart';
import '../../../core/widgets/app_offline_banner.dart';
import '../../../core/widgets/app_state_view.dart';
import '../../../core/widgets/app_text_field.dart';

/// The component showcase screen.
///
/// It renders every shared widget so that a project can review the look and
/// feel of the design system in one place.
class ShowcasePage extends StatefulWidget {
  const ShowcasePage({super.key});

  @override
  State<ShowcasePage> createState() => _ShowcasePageState();
}

class _ShowcasePageState extends State<ShowcasePage> {
  final TextEditingController _controller = TextEditingController();

  String _message = 'Shared components render with the application theme.';

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  void _show(String message) {
    setState(() {
      _message = message;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Showcase')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            AppCard(title: 'Message', child: AppMessage(text: _message)),
            const AppOfflineBanner(message: 'Offline changes are saved on this device.'),
            const AppCard(
              title: 'List item',
              child: AppListItem(title: 'Example row', subtitle: 'Direction-aware layout'),
            ),
            AppCard(
              title: 'Dialogs and sheets',
              child: Wrap(
                spacing: 8,
                children: [
                  TextButton(
                    onPressed: () async {
                      final confirmed = await showAppConfirmationDialog(
                        context: context,
                        title: 'Confirm action?',
                        message: 'This is a sample confirmation.',
                        confirmLabel: 'Confirm',
                        cancelLabel: 'Cancel',
                      );
                      if (confirmed == true && context.mounted) _show('Confirmed.');
                    },
                    child: const Text('Confirmation'),
                  ),
                  TextButton(
                    onPressed: () => AppBottomSheet.show<void>(
                      context,
                      builder: (_) => const Padding(
                        padding: EdgeInsets.all(24),
                        child: Text('Sample bottom sheet'),
                      ),
                    ),
                    child: const Text('Bottom sheet'),
                  ),
                ],
              ),
            ),
            AppCard(
              title: 'Buttons',
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  AppPrimaryButton(
                    label: 'Primary action',
                    onPressed: () => _show('Primary action pressed.'),
                  ),
                  const SizedBox(height: 8),
                  AppSecondaryButton(
                    label: 'Secondary action',
                    onPressed: () => _show('Secondary action pressed.'),
                  ),
                ],
              ),
            ),
            AppCard(
              title: 'Text field',
              child: AppTextField(
                label: 'Your name',
                controller: _controller,
                onChanged: (value) => _show('Typed: $value'),
              ),
            ),
            AppCard(
              title: 'States',
              child: Column(
                children: [
                  const SizedBox(height: 260, child: AppLoadingView()),
                  const SizedBox(height: 260, child: AppEmptyView()),
                  SizedBox(
                    height: 260,
                    child: AppErrorView(onRetry: () => _show('Retry pressed.')),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
