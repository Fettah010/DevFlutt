import 'package:flutter/material.dart';

/// The primary action button of the application.
class AppPrimaryButton extends StatelessWidget {
  const AppPrimaryButton({super.key, required this.label, required this.onPressed});

  /// The text shown inside the button.
  final String label;

  /// Called when the button is pressed. A null value disables the button.
  final VoidCallback? onPressed;

  @override
  Widget build(BuildContext context) {
    return FilledButton(onPressed: onPressed, child: Text(label));
  }
}

/// The secondary action button of the application.
class AppSecondaryButton extends StatelessWidget {
  const AppSecondaryButton({super.key, required this.label, required this.onPressed});

  /// The text shown inside the button.
  final String label;

  /// Called when the button is pressed. A null value disables the button.
  final VoidCallback? onPressed;

  @override
  Widget build(BuildContext context) {
    return OutlinedButton(onPressed: onPressed, child: Text(label));
  }
}
