<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android 12 and newer equivalent of backup_rules.xml. The same
    SharedPreferences file is excluded from cloud backup and from device
    transfer, for the same reason: the wrapped key does not leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
