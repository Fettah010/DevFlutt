Page<void> _routePage(BuildContext context, GoRouterState state, Widget child) {
  if (MediaQuery.disableAnimationsOf(context)) {
    return NoTransitionPage<void>(key: state.pageKey, child: child);
  }

  return CustomTransitionPage<void>(
    key: state.pageKey,
    child: child,
    transitionDuration: AppDurations.normal,
    reverseTransitionDuration: AppDurations.fast,
    transitionsBuilder: (context, animation, secondaryAnimation, child) =>
        FadeTransition(
      opacity: CurvedAnimation(parent: animation, curve: AppCurves.standard),
      child: child,
    ),
  );
}

/// Builds the application router.
///
/// Every route path comes from [AppRoutes], so navigation never uses a raw
/// string literal. The redirect hook is [routeGuard]; pass a different
/// [RouteRedirect] to add authentication or feature-flag redirects.
GoRouter buildAppRouter({RouteRedirect redirect = routeGuard}) {
  return GoRouter(
    initialLocation: AppRoutes.home,
    redirect: (context, state) => redirect(state),
    routes: [
      GoRoute(
        path: AppRoutes.home,
        pageBuilder: (context, state) =>
            _routePage(context, state, const HomePage()),
      ),
{{#hasFeatureExample}}      GoRoute(
        path: AppRoutes.counter,
        pageBuilder: (context, state) =>
            _routePage(context, state, const CounterPage()),
      ),
{{/hasFeatureExample}}{{#hasShowcase}}      GoRoute(
        path: AppRoutes.showcase,
        pageBuilder: (context, state) =>
            _routePage(context, state, const ShowcasePage()),
      ),
{{/hasShowcase}}{{#hasOfflineData}}      GoRoute(
        path: AppRoutes.offlineNotes,
        pageBuilder: (context, state) =>
            _routePage(context, state, OfflineNotesPage()),
      ),
{{/hasOfflineData}}{{#hasCommerce}}      GoRoute(
        path: AppRoutes.commerce,
        pageBuilder: (context, state) => _routePage(context, state, {{#hasCommercePersistence}}CommercePage(
          cartStore: DatabaseCartStore(AppDatabase.defaults()),
        ){{/hasCommercePersistence}}{{^hasCommercePersistence}}CommercePage(){{/hasCommercePersistence}}),
      ),
{{/hasCommerce}}    ],
    errorPageBuilder: (context, state) => _routePage(
      context,
      state,
      NotFoundPage(location: state.uri.toString()),
    ),
  );
}
