/// The services the application composes at startup.
///
/// The class holds exactly the services the selected modules provide. A
/// project that does not select a module does not get its field, and a
/// project that selects no service module does not have this file at all.
class AppServices {
  /// Creates the services.
  AppServices({
{{#hasLogging}}    required this.logger,
{{/hasLogging}}{{#hasNetworking}}    required this.apiClient,
{{/hasNetworking}}{{#hasBackendFirestore}}    required this.firestoreClient,
{{/hasBackendFirestore}}{{#hasBackendSupabase}}    required this.supabaseDataClient,
{{/hasBackendSupabase}}{{#hasSecureStorage}}    required this.secureStore,
{{/hasSecureStorage}}{{#hasDiagnostics}}    required this.errorReporter,
{{/hasDiagnostics}}{{#hasAuth}}    required this.authAdapter,
{{/hasAuth}}  });
{{#hasLogging}}
  /// The application logger.
  final AppLogger logger;
{{/hasLogging}}{{#hasNetworking}}
  /// The HTTP client used by the features.
  final ApiClient apiClient;
{{/hasNetworking}}{{#hasBackendFirestore}}
  /// The Firebase Firestore document client.
  final FirestoreDocumentClient firestoreClient;
{{/hasBackendFirestore}}{{#hasBackendSupabase}}
  /// The Supabase Postgres/PostgREST data client.
  final SupabaseDataClient supabaseDataClient;
{{/hasBackendSupabase}}{{#hasSecureStorage}}
  /// The store for sensitive values.
  final SecureStore secureStore;
{{/hasSecureStorage}}{{#hasDiagnostics}}
  /// The reporter that records application errors.
  final ErrorReporter errorReporter;
{{/hasDiagnostics}}{{#hasAuth}}
  /// The authentication adapter.
  ///
  /// The provider is behind the interface, so a feature never sees a provider
  /// type and changing the provider does not change the feature.
  final AuthAdapter authAdapter;
{{/hasAuth}}
}

/// Builds the services for [config].
///
/// This is the only place where the concrete implementations are chosen. A
/// feature receives the service it needs through its constructor, so the
/// choice stays in one reviewable file.
AppServices buildAppServices(AppConfig config) {
{{#hasLogging}}  final logger = ConsoleLogger(
    minimumLevel: ConsoleLogger.minimumLevelFor(config.environment),
  );
{{/hasLogging}}{{#hasNetworking}}  final apiClient = RetryingApiClient(
    inner: DioApiClient(baseUrl: config.apiBaseUrl, logger: logger),
    policy: const RetryPolicy(maxAttempts: 3),
    logger: logger,
  );
{{/hasNetworking}}{{#hasBackendFirestore}}  final firestoreClient = FirestoreDocumentClient(
    port: FirebaseFirestoreDocumentPort(),
  );
{{/hasBackendFirestore}}{{#hasBackendSupabase}}  final supabaseDataClient = SupabaseDataClient(
    port: SupabaseDataPortImpl(),
  );
{{/hasBackendSupabase}}{{#hasSecureStorage}}  final secureStore = const FlutterSecureStore();
{{/hasSecureStorage}}{{#hasAuthRest}}  final restAuthConfig = defaultRestAuthConfig;
  final authAdapter = RestAuthAdapter(
    port: DioRestAuthPort(client: apiClient, config: restAuthConfig),
    config: restAuthConfig,
    sessionStore: SecureSessionStore(secureStore),
  );
{{/hasAuthRest}}{{#hasAuthFirebase}}  final authAdapter = FirebaseAuthAdapter(
    port: FirebaseAuthPortImpl(),
  );
{{/hasAuthFirebase}}{{#hasAuthSupabase}}  final authAdapter = SupabaseAuthAdapter(
    port: SupabaseAuthPortImpl(),
  );
{{/hasAuthSupabase}}
  return AppServices(
{{#hasLogging}}    logger: logger,
{{/hasLogging}}{{#hasNetworking}}    apiClient: apiClient,
{{/hasNetworking}}{{#hasBackendFirestore}}    firestoreClient: firestoreClient,
{{/hasBackendFirestore}}{{#hasBackendSupabase}}    supabaseDataClient: supabaseDataClient,
{{/hasBackendSupabase}}{{#hasSecureStorage}}    secureStore: secureStore,
{{/hasSecureStorage}}{{#hasDiagnostics}}    errorReporter: LocalErrorReporter(logger: logger),
{{/hasDiagnostics}}{{#hasAuth}}    authAdapter: authAdapter,
{{/hasAuth}}  );
}
