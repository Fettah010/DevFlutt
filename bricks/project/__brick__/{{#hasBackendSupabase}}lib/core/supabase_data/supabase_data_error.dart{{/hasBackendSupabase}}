/// A safe, provider-independent Supabase data operation failure.
enum SupabaseDataErrorCode {
  permissionDenied,
  unauthenticated,
  unavailable,
  invalidArgument,
  malformedData,
  unknown,
}

/// A failure that does not retain provider text or row data.
final class SupabaseDataError {
  const SupabaseDataError(this.code);

  /// The stable category of the failure.
  final SupabaseDataErrorCode code;

  /// A safe message suitable for application handling.
  String get message => switch (code) {
    SupabaseDataErrorCode.permissionDenied => 'The operation is not permitted.',
    SupabaseDataErrorCode.unauthenticated => 'Authentication is required.',
    SupabaseDataErrorCode.unavailable => 'The data service is unavailable.',
    SupabaseDataErrorCode.invalidArgument => 'The data request is invalid.',
    SupabaseDataErrorCode.malformedData => 'The table data could not be read.',
    SupabaseDataErrorCode.unknown => 'The data operation failed.',
  };
}
