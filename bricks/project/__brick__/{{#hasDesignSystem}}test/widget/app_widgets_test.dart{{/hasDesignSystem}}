import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

import 'package:{{projectName}}/core/widgets/app_button.dart';
import 'package:{{projectName}}/core/widgets/app_bottom_sheet.dart';
import 'package:{{projectName}}/core/widgets/app_card.dart';
import 'package:{{projectName}}/core/widgets/app_confirmation_dialog.dart';
import 'package:{{projectName}}/core/widgets/app_list_item.dart';
import 'package:{{projectName}}/core/widgets/app_message.dart';
import 'package:{{projectName}}/core/widgets/app_offline_banner.dart';
import 'package:{{projectName}}/core/widgets/app_state_view.dart';
import 'package:{{projectName}}/core/widgets/app_text_field.dart';

void _noop() {}

void main() {
  group('AppPrimaryButton', () {
    testWidgets('calls the action when pressed', (tester) async {
      var pressed = false;

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: AppPrimaryButton(
              label: 'Press me',
              onPressed: () => pressed = true,
            ),
          ),
        ),
      );

      await tester.tap(find.text('Press me'));
      await tester.pumpAndSettle();

      expect(pressed, isTrue);
    });
  });

  group('AppSecondaryButton', () {
    testWidgets('renders its label', (tester) async {
      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: AppSecondaryButton(label: 'Cancel', onPressed: () {}),
          ),
        ),
      );

      expect(find.text('Cancel'), findsOneWidget);
    });
  });

  group('AppTextField', () {
    testWidgets('reports every change', (tester) async {
      String? value;

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: AppTextField(
              label: 'Name',
              onChanged: (text) => value = text,
            ),
          ),
        ),
      );

      await tester.enterText(find.byType(TextField), 'Ada');
      await tester.pumpAndSettle();

      expect(value, 'Ada');
    });

    testWidgets('supports Form validation', (tester) async {
      final formKey = GlobalKey<FormState>();

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: Form(
              key: formKey,
              child: const AppTextField(
                label: 'Email',
                validator: _requiredValidator,
              ),
            ),
          ),
        ),
      );

      expect(formKey.currentState!.validate(), isFalse);
      await tester.pump();
      expect(find.text('Required'), findsOneWidget);
    });
  });

  group('AppCard', () {
    testWidgets('renders its title and its content', (tester) async {
      await tester.pumpWidget(
        const MaterialApp(
          home: Scaffold(
            body: AppCard(title: 'Section', child: Text('Body')),
          ),
        ),
      );

      expect(find.text('Section'), findsOneWidget);
      expect(find.text('Body'), findsOneWidget);
    });
  });

  group('AppMessage', () {
    testWidgets('renders its text', (tester) async {
      await tester.pumpWidget(
        const MaterialApp(
          home: Scaffold(
            body: AppMessage(text: 'Saved', severity: AppMessageSeverity.success),
          ),
        ),
      );

      expect(find.text('Saved'), findsOneWidget);
    });

    testWidgets('renders a dismiss action', (tester) async {
      var dismissed = false;

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: AppMessage(
              text: 'Saved',
              onDismiss: () => dismissed = true,
            ),
          ),
        ),
      );

      await tester.tap(find.byTooltip('Dismiss'));
      await tester.pumpAndSettle();

      expect(dismissed, isTrue);
    });
  });

  testWidgets('offline banner provides a persistent message', (tester) async {
    await tester.pumpWidget(
      const MaterialApp(home: Scaffold(body: AppOfflineBanner(message: 'Saved locally'))),
    );

    expect(find.text('Saved locally'), findsOneWidget);
    expect(find.byIcon(Icons.wifi_off), findsOneWidget);
    expect(tester.getSemantics(find.text('Saved locally')).flagsCollection.isLiveRegion, isTrue);
  });

  testWidgets('list item renders content and handles taps', (tester) async {
    var tapped = false;
    await tester.pumpWidget(
      MaterialApp(
        home: Scaffold(
          body: AppListItem(
            title: 'Profile',
            subtitle: 'Account settings',
            onTap: () => tapped = true,
          ),
        ),
      ),
    );

    expect(find.text('Profile'), findsOneWidget);
    expect(find.text('Account settings'), findsOneWidget);
    await tester.tap(find.text('Profile'));
    expect(tapped, isTrue);
  });

  testWidgets('list item places leading and trailing content by text direction', (tester) async {
    await tester.pumpWidget(
      const MaterialApp(
        home: Directionality(
          textDirection: TextDirection.rtl,
          child: Scaffold(
            body: AppListItem(
              title: 'عنوان',
              leading: Icon(Icons.star),
              trailing: Icon(Icons.chevron_right),
            ),
          ),
        ),
      ),
    );

    final leading = tester.getCenter(find.byIcon(Icons.star));
    final trailing = tester.getCenter(find.byIcon(Icons.chevron_right));
    expect(leading.dx, greaterThan(trailing.dx));
  });

  testWidgets('confirmation dialog returns the chosen result', (tester) async {
    bool? result;
    await tester.pumpWidget(
      MaterialApp(
        home: Builder(
          builder: (context) => TextButton(
            onPressed: () async {
              result = await showAppConfirmationDialog(
                context: context,
                title: 'Delete item?',
                message: 'This cannot be undone.',
                confirmLabel: 'Delete',
                cancelLabel: 'Cancel',
                destructive: true,
              );
            },
            child: const Text('Open dialog'),
          ),
        ),
      ),
    );

    await tester.tap(find.text('Open dialog'));
    await tester.pumpAndSettle();
    await tester.tap(find.text('Delete'));
    await tester.pumpAndSettle();

    expect(result, isTrue);
  });

  testWidgets('bottom sheet uses the shared modal presentation', (tester) async {
    await tester.pumpWidget(
      MaterialApp(
        home: Builder(
          builder: (context) => TextButton(
            onPressed: () => AppBottomSheet.show<void>(
              context,
              builder: (_) => const Text('Sheet content'),
            ),
            child: const Text('Open sheet'),
          ),
        ),
      ),
    );

    await tester.tap(find.text('Open sheet'));
    await tester.pumpAndSettle();

    expect(find.text('Sheet content'), findsOneWidget);
  });

  group('App state views', () {
    testWidgets('render their default content', (tester) async {
      await tester.pumpWidget(
        const MaterialApp(home: Scaffold(body: AppLoadingView())),
      );

      expect(find.text('Loading'), findsOneWidget);

      await tester.pumpWidget(
        const MaterialApp(home: Scaffold(body: AppEmptyView())),
      );

      expect(find.text('Nothing here yet'), findsOneWidget);

      await tester.pumpWidget(
        const MaterialApp(home: Scaffold(body: AppErrorView(onRetry: _noop))),
      );

      expect(find.text('Something went wrong'), findsOneWidget);
    });

    testWidgets('the error view reports a retry', (tester) async {
      var retried = false;

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: AppErrorView(onRetry: () => retried = true),
          ),
        ),
      );

      await tester.tap(find.text('Try again'));
      await tester.pumpAndSettle();

      expect(retried, isTrue);
    });
  });
}

String? _requiredValidator(String? value) => value == null || value.isEmpty ? 'Required' : null;
